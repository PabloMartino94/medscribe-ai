# Copy to .env and fill in. Never commit the filled-in file.

# --- Proveedor de IA ---------------------------------------------------------
# "openai" o "gemini". Gemini expone una API compatible con OpenAI, así que el
# mismo cliente sirve para los dos; solo la transcripción cambia de camino.
AI_PROVIDER=openai

# La clave del proveedor elegido:
#   openai → https://platform.openai.com/api-keys
#   gemini → https://aistudio.google.com/apikey
AI_API_KEY=

# Opcionales: apuntar a otro gateway compatible con OpenAI, o cambiar de modelo.
# Por defecto: openai → gpt-4o-mini-transcribe / gpt-4o
#              gemini → gemini-2.5-flash para ambos
# AI_BASE_URL=
# AI_TRANSCRIBE_MODEL=
# AI_STRUCTURE_MODEL=

# --- Supabase ---------------------------------------------------------------
# Project settings → Data API. La clave publishable (anon) es la única que esta
# app necesita: el servidor actúa como el médico que hizo el pedido, así que la
# RLS siempre aplica. Nunca pongas acá la clave service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Servidor ---------------------------------------------------------------
# PORT=8080
# LOG_LEVEL=info
# Solo si el frontend vive en otro origen distinto al de la API.
# CORS_ORIGINS=https://app.example.com
# Ruta al frontend compilado; por defecto artifacts/medscribe/dist/public
# STATIC_DIR=
# Ruta al binario de ffmpeg; por defecto `ffmpeg` en el PATH
# FFMPEG_PATH=
