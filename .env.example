# Copy to .env and fill in. Never commit the filled-in file.

# --- OpenAI -----------------------------------------------------------------
# Create a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: point at an OpenAI-compatible gateway instead of api.openai.com
# OPENAI_BASE_URL=
# Optional: override the models (defaults shown)
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini-transcribe
# OPENAI_STRUCTURE_MODEL=gpt-4o

# --- Supabase ---------------------------------------------------------------
# Project settings → Data API. The publishable (anon) key is the only one this
# app needs: the server acts as the signed-in physician so RLS always applies.
# Never put the service_role key here.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# --- Server -----------------------------------------------------------------
# PORT=8080
# LOG_LEVEL=info
# Only needed if the frontend is hosted on a different origin than the API.
# CORS_ORIGINS=https://app.example.com
# Path to the built frontend; defaults to artifacts/medscribe/dist/public
# STATIC_DIR=
# Path to the ffmpeg binary; defaults to `ffmpeg` on PATH
# FFMPEG_PATH=
